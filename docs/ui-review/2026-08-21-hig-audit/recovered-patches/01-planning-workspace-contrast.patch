@@ -88,6 +88,26 @@
   --muted-text:  var(--muted);
   --success:     var(--ok);
   --warning:     var(--warn);
+  /* Foreground for text sitting ON --warn/--warning. Must be redefined in every
+     theme: --warn is a mid amber in light/dark but a dark brown in hc and
+     prefers-contrast, so a single hard-coded ink cannot serve both. */
+  --on-warn:     #101A26;   /* 5.23:1 on light --warn #c97a00 */
+
+  /* ── Foreground roles (AUDIT-2026-08 G1) ─────────────────────────────────
+     Every colour here is a FOREGROUND for a specific surface, and must be
+     redefined in each theme. These exist because component rules were
+     hard-coding inks (#a86600, #1D2733, #002F65) that cannot follow a theme.
+     "-on-tint" = text on a color-mix() status tint, not on a flat surface. */
+  --emphasis:        var(--primary);  /* surface for emphasised controls */
+  --on-emphasis:     #ffffff;         /* 13.17:1 on light --primary #002f65 */
+  --on-danger:       #ffffff;         /* 4.83:1  on light --red  #e51937 */
+  --on-accent:       #002F65;         /* ink on --aafc-blue (scope pill) */
+  --muted-on-sunk:   #5c6a76;         /* 5.07:1 on --surface-2 #f0f5fa */
+  --ok-on-tint:      #166c40;         /* 5.06:1 on ok-tinted surface */
+  --warn-on-tint:    #8d5500;         /* 5.02:1 on warn-tinted surface */
+  --danger-on-tint:  #c3152f;         /* 4.74:1 on danger-tinted surface */
+  --resch-on-tint:   #6d2ed6;         /* 5.55:1 on rescheduled-tinted surface (base #7c3aed was 4.53 — too thin) */
+  --blue-on-tint:    #004b8d;         /* 6.81:1 on royal-tinted surface */
 }
 
