+  --on-danger:      #101A26;   /* 7.35:1 on dark --red #ff6b6b */
+  --on-accent:      #101A26;   /* 7.24:1 on dark --aafc-blue #51b0e3 */
+  --muted-on-sunk:  #9fb2c6;   /* 7.23:1 on dark --surface-2 #16233a */
+  --ok-on-tint:     #3EAE77;   /* 4.61:1 */
+  --warn-on-tint:   #D9982E;   /* 5.17:1 */
+  --danger-on-tint: #ff6b6b;   /* 5.03:1 */
