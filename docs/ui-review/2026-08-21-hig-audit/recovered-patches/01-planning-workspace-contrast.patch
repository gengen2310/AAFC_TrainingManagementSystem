+     stripped .banner.proxy of its background entirely. Lightened for dark surfaces
+     in the same spirit as --red above. */
+  --ok:         #3EAE77;   /* 6.12:1 on --surface, 6.61 on --background, 5.63 on --surface-2 */
+  --warn:       #D9982E;   /* 6.90:1 on --surface, 7.45 on --background, 6.35 on --surface-2 */
+  --on-warn:    #101A26;   /* 7.08:1 on dark --warn #D9982E */
+  /* AUDIT-2026-08 G1 — dark foreground roles.
+     --primary is the CHROME surface (topbar, context bar, table headers) and is
