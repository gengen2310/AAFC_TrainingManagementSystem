connected-frontend/.local-dev/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Claude Code IDE — include project rules, exclude local/session files
.claude/settings.local.json
.claude/todos.json
.claude/*.jsonl
.claude/projects/
.claude/worktrees/

# Stress / smoke test scripts contain hardcoded dev seed codes — never commit
tools/stress/
frontend/test-results/
