*.db
*.db-shm
*.db-wal

# Backups
backups/

# Test / coverage artefacts
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Logs
*.log
logs/

# Distribution packages / delivery ZIPs
*.zip
*.tar.gz
